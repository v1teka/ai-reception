ANTHROPIC_API_KEY=sk-ant-...

# ---------- Telegram-бот для барбершопа (npm run bot) ----------
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Telegram ID владельцев и мастеров через запятую (свой ID подскажет @userinfobot).
# Можно не заполнять: при первом запуске бот напишет в лог ссылку «стать владельцем».
OWNER_IDS=
ADMIN_IDS=
# Необязательно: второй бот только для панели мастера.
# Удобно, когда один человек проверяет и клиента, и мастера.
ADMIN_BOT_TOKEN=

# Необязательно: ключ партнёра YCLIENTS (маркетплейс YCLIENTS → кабинет разработчика → «Настройки аккаунта»).
# С ним мастер может подключить свой филиал YCLIENTS в «Настройках точки»: бот будет брать
# свободное время из YCLIENTS и записывать клиентов прямо в журнал.
YCLIENTS_PARTNER_TOKEN=

# ---------- Тонкая настройка (можно не трогать) ----------
# Модель. Скорость ответа клиенту: low — быстрее; разбор карточки и прайса: medium
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=low
# ANTHROPIC_SETUP_EFFORT=medium
# Если ИИ не ответил за столько мс или уверенность ниже порога — бот молчит и зовёт мастера
# LLM_TIMEOUT_MS=30000
# CONFIDENCE_THRESHOLD=0.6
# Защита от спама: не больше стольких запросов к ИИ в час на один чат
# LLM_CALLS_PER_HOUR=40
# «Печатает…»: длительность = BASE + длина ответа × PER_CHAR, в пределах MIN..MAX
# TYPING_BASE_MS=400
# TYPING_MS_PER_CHAR=12
# TYPING_MIN_MS=800
# TYPING_MAX_MS=4000
# Сколько ждать, не допишет ли клиент ещё одно сообщение
# DEBOUNCE_MS=1500
# За сколько минут напомнить клиенту о визите
# REMINDER_MINUTES=120
# Где хранить данные бота (state.json)
# DATA_DIR=./data
